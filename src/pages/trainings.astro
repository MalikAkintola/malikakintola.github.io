---
// Trainings. The four packages from src/content/trainings.yaml, compared in one large table; the
// complete package drawn as its three months; each course's eight modules; photographs of classes in
// two rows that drift in opposite directions; and corporate training by email in the closing band.
// Prices show in naira or in dollars, whichever the visitor picks.
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import { span } from '../lib/dates';
import { nb } from '../lib/text';
import excelLogo from '../assets/logos/excel.png';
import postgresLogo from '../assets/logos/postgresql.png';
import powerBiLogo from '../assets/logos/power-bi.png';

const me = (await getEntry('profile', 'me'))!.data;
const packages = (await getCollection('trainings')).sort((a, b) => a.data.order - b.data.order).map((p) => ({ id: p.id, ...p.data }));
const programme = packages.find((p) => p.kind === 'programme')!;
const courses = packages.filter((p) => p.kind === 'course');
const fromNgn = Math.min(...courses.map((c) => c.ngn));
const fromUsd = Math.min(...courses.map((c) => c.usd));
// Hours of live one-on-one time in a month of the complete package.
const monthHours = (programme.hoursPerWeek ?? 4) * 4;
// The logo in each month's box, by the tool's name in trainings.yaml. Excel's logo is white on its own
// green, so its box takes that green; the other two are on white, so their boxes are light.
const logos: Record<string, { src: ImageMetadata; tone: 'excel' | 'light' }> = {
  Excel: { src: excelLogo, tone: 'excel' },
  SQL: { src: postgresLogo, tone: 'light' },
  'Power BI': { src: powerBiLogo, tone: 'light' },
};

// The teaching roles from experience.yaml, as the record beside the photographs.
const teachingIds = ['hagital', 'career-expo', 'investment-society', 'dsn'];
const roles = await getCollection('experience');
const record = teachingIds.map((id) => roles.find((r) => r.id === id)).filter((r) => r !== undefined);

// Photographs of classes: every picture in src/assets/Training Pictures. Write what each one shows
// here, by file name, for people who cannot see it.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/Training Pictures/*.{jpg,jpeg,png,webp}', { eager: true });
const alts: Record<string, string> = {
  '20241207_113129.jpg': 'Teaching from a lectern in a computer lab, with the lesson on the screen behind',
  '20250218_120122.jpg': 'Learners with laptops round a long table, following code on a large wall screen',
  'IMG_20230707_135422.jpg': 'A group photograph from a free AI class, the class holding its banner in front of a painted wall',
  'VideoCapture_20241208-182649.jpg': 'Teaching from the lectern in a computer lab, with data on the screen behind',
  'VideoCapture_20241210-163438.jpg': 'Teaching from the lectern beside a spreadsheet on the wall screen',
  'VideoCapture_20241216-224532.jpg': 'Presenting a Power BI dashboard to a class seated round a conference table',
  'VideoCapture_20241216-224618.jpg': 'A class with laptops watching a dashboard walkthrough on the wall screen',
  'VideoCapture_20241216-224805.jpg': 'Walking a class through a dashboard on the wall screen',
  'VideoCapture_20241217-132543.jpg': 'Teaching from the lectern beside a dashboard on the wall screen',
};
const photos = Object.entries(files)
  .map(([path, mod]) => {
    const name = path.split('/').pop()!;
    return { name, src: mod.default, alt: alts[name] ?? 'A training class in session' };
  })
  .sort((a, b) => a.name.localeCompare(b.name));
const byName = (n: string) => photos.find((p) => p.name === n);
const lead = byName('20250218_120122.jpg') ?? photos[0];
const closing = byName('VideoCapture_20241216-224805.jpg') ?? photos[photos.length - 1];
// Two rows of every photograph, in different orders, so the rows never show the same pair.
const rowA = photos;
const rowB = [...photos.slice(Math.ceil(photos.length / 2)), ...photos.slice(0, Math.ceil(photos.length / 2))].reverse();

const ngn = (n: number) => `₦${n.toLocaleString('en-US')}`;
const usd = (n: number) => `$${n.toLocaleString('en-US', { minimumFractionDigits: Number.isInteger(n) ? 0 : 2, maximumFractionDigits: 2 })}`;
const per = (p: (typeof packages)[number]) => (p.per === 'month' ? 'a month' : 'an hour');

const mail = (subject: string, body: string) =>
  `mailto:${me.trainingsEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
const bookingMail = (name: string) =>
  mail(`Training: ${name}`, `Hello Malik,\n\nI would like to book the ${name}.\n\nI will pay in (naira or dollars):\nWhat I can do so far:\nWhat I want to be able to do:\nWhen I am free for sessions:\n\nThank you.`);
const corporateMail = mail(
  'Corporate training',
  `Hello Malik,\n\nWe would like training for our team.\n\nCompany:\nNumber of people:\nTools (Excel, SQL, Power BI):\nWhat the team needs to be able to do:\nPreferred dates and format:\n\nThank you.`,
);
const generalMail = mail('Training', 'Hello Malik,\n\nI would like to learn data analysis with you.\n\nI will pay in (naira or dollars):\nWhat I want to learn:\n\nThank you.');

const anchorOf = (p: (typeof packages)[number]) => (p.kind === 'programme' ? '#complete' : `#${p.id}`);
const rows = ['What you learn', 'Typical length', 'Sessions', 'Paying'] as const;
---
<Base
  title={`Trainings, ${me.name}`}
  description={`One-on-one online training in Excel, SQL and Power BI with ${me.name}, from ${ngn(fromNgn)} or ${usd(fromUsd)} an hour, and a three-month complete data analysis package. Corporate training by email.`}
>
  <script is:inline slot="head">
    (function () {
      var c = null;
      try { c = localStorage.getItem('currency'); } catch (e) {}
      if (c !== 'ngn' && c !== 'usd') {
        var tz = '';
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        c = tz === 'Africa/Lagos' ? 'ngn' : 'usd';
      }
      document.documentElement.dataset.currency = c;
    })();
  </script>
  <SiteNav />
  <main id="main" class="trainings">
    <header class="grid page-head">
      <h1 class="display page-head__title" data-reveal>Trainings</h1>
      <div class="page-head__side">
        <p class="lead" data-reveal style="--i: 1">
          {nb('Learn Excel, SQL and Power BI with me, one-on-one and online, at your pace, with AI built into every course.')}
        </p>
        <p data-reveal style="--i: 2">
          {nb(`I have taught more than 600 learners and hold Microsoft’s Power BI and Fabric certifications. Courses from `)}<span class="price"><span data-cur="ngn">{ngn(fromNgn)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(fromUsd)}</span></span> an hour.
        </p>
        <div class="page-head__actions" data-reveal style="--i: 3">
          <a class="button" href="#packages">See the four packages</a>
          <a class="link" href="#corporate">Training a team? Email me</a>
        </div>
      </div>
      <figure class="lead-photo" data-reveal style="--i: 2">
        <div class="lead-photo__frame">
          <Image src={lead.src} alt={lead.alt} widths={[640, 960, 1280, 1920, 2560]} sizes="(max-width: 100rem) 94vw, 100rem" loading="eager" fetchpriority="high" />
        </div>
      </figure>
    </header>

    <!-- The packages, compared. Each package is one column (one block on a phone); the labels on the
         left are drawn once for the eye, and repeated inside each cell for screen readers. -->
    <section id="packages" class="band band--grey packages" aria-labelledby="packages-title">
      <div class="grid">
        <div class="plans">
          <div class="plans__intro">
            <h2 id="packages-title" class="head" data-reveal>Four packages</h2>
            <p data-reveal style="--i: 1">
              {nb('All three tools in one three-month programme, or one tool at a time, booked by the hour. Every session is live, online and one-on-one.')}
            </p>
            <div class="currency" role="group" aria-labelledby="currency-label" data-reveal style="--i: 2">
              <span id="currency-label" class="currency__label">Show prices in</span>
              <div class="currency__options">
                <button type="button" class="currency__option" data-currency-set="ngn" aria-pressed="false">₦ Naira</button>
                <button type="button" class="currency__option" data-currency-set="usd" aria-pressed="false">$ Dollar</button>
              </div>
            </div>
          </div>

          <div class="plans__labels" aria-hidden="true">
            {rows.map((r) => <div class="plans__label">{r}</div>)}
            <div class="plans__label"></div>
          </div>

          {packages.map((p, i) => (
            <article class:list={['plan', p.kind === 'programme' && 'plan--featured band--ink']} aria-labelledby={`plan-${p.id}`} data-reveal style={`--i: ${i + 1}`}>
              <div class="plan__head">
                <h3 id={`plan-${p.id}`} class="plan__name"><span class="sr-only">{p.name}: </span><span aria-hidden="true">{p.short}</span></h3>
                <p class="plan__price nums">
                  <span class="price"><span data-cur="ngn">{ngn(p.ngn)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(p.usd)}</span></span>
                  <span class="plan__per">{per(p)}</span>
                </p>              </div>
              <div class="plan__cell">
                <span class="plan__label">What you learn</span>
                <p>{nb(p.learn)}</p>
                <a class="link plan__more" href={anchorOf(p)} data-show-course={p.kind === 'course' ? p.id : undefined}>
                  {p.kind === 'programme' ? 'See the three months' : 'See the eight modules'}
                </a>
              </div>
              <div class="plan__cell plan__cell--alt">
                <span class="plan__label">Typical length</span>
                <p>{p.kind === 'programme' ? p.length : `${p.length}, longer if you book more hours`}</p>
              </div>
              <div class="plan__cell">
                <span class="plan__label">Sessions</span>
                <p>{p.kind === 'programme'
                  ? `Two 2-hour sessions a week, ${monthHours} hours a month`
                  : '2-hour sessions, booked by the hour'}</p>
              </div>
              <div class="plan__cell plan__cell--alt">
                <span class="plan__label">Paying</span>
                {p.kind === 'programme' ? (
                  <p>At the start of each month, or <span class="price nums"><span data-cur="ngn">{ngn(p.ngn / 2)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(p.usd / 2)}</span></span> before each block of four sessions</p>
                ) : (
                  <p>Before sessions begin. A 2-hour session is <span class="price nums"><span data-cur="ngn">{ngn(p.ngn * 2)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(p.usd * 2)}</span></span></p>
                )}
              </div>
              <div class="plan__cell plan__cell--action">
                <a class:list={['button', p.kind !== 'programme' && 'button--ink']} href={bookingMail(p.name)}>Book {p.short}</a>
              </div>
            </article>
          ))}
        </div>

        <div class="packages__after">
          <h3 class="packages__after-title" data-reveal>Every package includes</h3>
          <ul class="packages__included" data-reveal style="--i: 1">
            <li>Sessions paced to your level and goals</li>
            <li>Practice datasets and exercises</li>
            <li>Feedback on your work</li>
            <li>Support between sessions</li>
            <li>A capstone project for your portfolio</li>
            <li>A module on using AI well</li>
          </ul>
          <p class="packages__terms small" data-reveal style="--i: 2">
            All sessions are online, at times agreed in advance. Payment is made before sessions begin, in naira
            or in dollars, whichever you prefer.
          </p>
        </div>
      </div>
    </section>

    <!-- The complete package as its own chart: three months end to end, AI under all of them. -->
    <section id="complete" class="band complete" aria-labelledby="complete-title">
      <div class="grid">
        <div class="rail">
          <div class="rail__inner">
            <h2 id="complete-title" class="head" data-reveal>Three months, three tools</h2>
            <p data-reveal style="--i: 1">
              {nb(`The ${programme.name} takes you through Excel, SQL and Power BI one after another, in two 2-hour sessions a week, and ends with a capstone project for your portfolio.`)}
            </p>
            <p class="complete__price nums" data-reveal style="--i: 2">
              <span class="price"><span data-cur="ngn">{ngn(programme.ngn)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(programme.usd)}</span></span> {per(programme)}
            </p>
            <div data-reveal style="--i: 3"><a class="button" href={bookingMail(programme.name)}>Book the {programme.short} package</a></div>
          </div>
        </div>

        <div class="content">
          <div class="months" data-reveal>
            {programme.months?.map((m, i) => {
              const logo = logos[m.tool];
              return (
                <div class:list={['months__bar', logo && `months__bar--${logo.tone}`]} aria-hidden="true" style={`--col: ${i + 1}; --row: ${i * 2 + 1}; --i: ${i}`}>
                  {logo
                    ? <Image class="months__logo" src={logo.src} alt="" widths={[240, 480, 720]} sizes="(max-width: 40em) 60vw, 16rem" />
                    : <span>{m.tool}</span>}
                </div>
              );
            })}
            <div class="months__ai" aria-hidden="true" style={`--i: ${programme.months?.length ?? 3}`}><span>AI, in every module</span></div>
            {programme.months?.map((m, i) => (
              <div class="months__text" style={`--col: ${i + 1}; --row: ${i * 2 + 2}`}>
                <h3 class="months__title">Month {i + 1}: {m.tool}</h3>
                <p>{nb(m.text)}</p>
              </div>
            ))}
          </div>

          <div class="complete__more">
            <div data-reveal>
              <h3 class="complete__subhead">AI all the way through</h3>
              <p>{nb(programme.ai ?? '')}</p>
            </div>
            <div data-reveal style="--i: 1">
              <h3 class="complete__subhead">Included</h3>
              <ul class="complete__list">
                {programme.included.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The three courses. With script, one course shows at a time; without it, all three in turn. -->
    <section id="courses" class="band band--grey courses" aria-labelledby="courses-title">
      <div class="grid">
        <div class="rail">
          <div class="rail__inner">
            <h2 id="courses-title" class="head" data-reveal>One tool at a time</h2>
            <p data-reveal style="--i: 1">
              {nb('Each course is eight modules, taught in order at your pace and booked by the hour. Each one ends with AI in your workflow and a project of your own.')}
            </p>
            <div class="tabs" role="tablist" aria-label="Courses" data-tabs data-reveal style="--i: 2">
              {courses.map((c, i) => (
                <button type="button" class="tabs__tab" role="tab" id={`tab-${c.id}`} aria-controls={c.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={c.id}>{c.short}</button>
              ))}
            </div>
          </div>
        </div>

        <div class="content">
          {courses.map((c, i) => (
            <div class="course" id={c.id} role="tabpanel" aria-labelledby={`tab-${c.id}`} data-panel={c.id} data-active={i === 0 ? 'true' : 'false'}>
              <div class="course__head" data-reveal>
                <h3 class="course__name">{nb(c.name)}</h3>
                <p class="lead">{nb(c.summary)}</p>
                <p class="course__facts nums">
                  <span class="price"><span data-cur="ngn">{ngn(c.ngn)}</span><span class="price__or"> or </span><span data-cur="usd">{usd(c.usd)}</span></span> {per(c)}, {c.length.toLowerCase()}
                </p>
              </div>
              <ol class="course__modules" data-reveal style="--i: 1">
                {c.modules?.map((m) => (
                  <li><span class="course__module">{nb(m.title)}</span> {nb(m.text)}</li>
                ))}
              </ol>
              <div class="course__foot" data-reveal style="--i: 2">
                <p class="small">{c.included.join('. ')}.</p>
                <a class="button" href={bookingMail(c.name)}>Book {c.short}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Photographs of classes: two rows drifting in opposite directions, with the teaching record. -->
    <section id="classroom" class="band classroom" aria-labelledby="classroom-title">
      <div class="grid classroom__head">
        <div class="classroom__intro">
          <h2 id="classroom-title" class="head" data-reveal>In the classroom</h2>
          <p data-reveal style="--i: 1">{nb('Classes I have taught in person, in Excel, SQL, Power BI and AI.')}</p>
          <button type="button" class="classroom__pause link" data-marquee-toggle aria-pressed="false" data-reveal style="--i: 2">Pause the photographs</button>
        </div>
        <ul class="record">
          {record.map((r, i) => (
            <li class="record__item" data-reveal style={`--i: ${i}`}>
              <p class="record__role"><span class="strong">{r.data.role}</span>, {r.data.org}</p>
              <p class="record__when small muted nums">{span(r.data.start, r.data.end)}</p>
              <p class="record__point">{nb(r.data.points[0])}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="marquees" data-marquees>
        {[rowA, rowB].map((row, r) => (
          <div class:list={['marquee', r === 1 && 'marquee--reverse']}>
            <div class="marquee__track">
              {[0, 1].map((copy) => (
                <ul class="marquee__set" aria-hidden={copy === 1 ? 'true' : undefined} role={copy === 0 ? 'list' : undefined}>
                  {row.map((p) => (
                    <li class="marquee__item" style={`--ratio: ${p.src.width / p.src.height}`}>
                      <Image src={p.src} alt={copy === 0 ? p.alt : ''} widths={[320, 640, 960, 1280]} sizes={`${Math.round(Math.min(2, p.src.width / p.src.height) * 360)}px`} loading="lazy" />
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <!-- The closing band: a class on a dark layer, carrying the corporate invitation and the footer. -->
  <div class="closing">
    <Image class="closing__pic" src={closing.src} alt="" widths={[960, 1600, 1920]} sizes="100vw" />
    <section id="corporate" class="band band--ink corporate" aria-labelledby="corporate-title">
      <div class="grid">
        <div class="rail">
          <div class="rail__inner">
            <h2 id="corporate-title" class="head" data-reveal>Corporate training</h2>
            <p data-reveal style="--i: 1">{nb('Excel, SQL and Power BI for teams, from analysts to managers who read the reports.')}</p>
          </div>
        </div>
        <div class="content">
          <p class="corporate__statement lead" data-reveal>
            {nb('For corporate trainings, reach out to me by email. Tell me how many people, which tools, and what the team needs to be able to do.')}
          </p>
          <div class="corporate__links" data-reveal style="--i: 1">
            <a class="corporate__email" href={corporateMail}>{me.trainingsEmail}</a>
            <div class="corporate__more">
              <a class="button" href={corporateMail}>Email me about corporate training</a>
              <a class="link" href={generalMail}>A question about one-on-one training</a>
              <a class="link" href={me.linkedin} rel="noopener" target="_blank">LinkedIn</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <Footer />
  </div>
</Base>

<script>
  // Prices in naira or dollars. Until the visitor picks, the page starts in naira for a Lagos time zone and
  // in dollars otherwise (set before it paints, in the head); a pick is remembered.
  const root = document.documentElement;
  const options = [...document.querySelectorAll<HTMLButtonElement>('[data-currency-set]')];
  const showCurrency = (c: string) => {
    root.dataset.currency = c;
    options.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.currencySet === c)));
  };
  showCurrency(root.dataset.currency === 'ngn' ? 'ngn' : 'usd');
  options.forEach((b) => b.addEventListener('click', () => {
    const c = b.dataset.currencySet!;
    showCurrency(c);
    try { localStorage.setItem('currency', c); } catch {}
  }));

  // Courses as tabs: arrow keys move between them, and a link to #excel, #sql or #power-bi opens that one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  if (tabs.length) {
    document.querySelector('.courses')?.classList.add('is-tabbed');
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => {
        p.dataset.active = String(p.dataset.panel === id);
        if (p.dataset.panel === id) p.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          select(tabs[e.key === 'Home' ? 0 : tabs.length - 1].dataset.tab!, true);
        } else if (step) {
          e.preventDefault();
          select(tabs[(i + step + tabs.length) % tabs.length].dataset.tab!, true);
        }
      });
    });
    const fromHash = () => {
      const id = location.hash.slice(1);
      if (!panels.some((p) => p.dataset.panel === id)) return;
      select(id);
      document.getElementById('courses')?.scrollIntoView({ block: 'start' });
    };
    // A link to one course scrolls to the section with that course open, not to the hidden panel.
    document.querySelectorAll<HTMLAnchorElement>('[data-show-course]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        select(a.dataset.showCourse!);
        history.replaceState(null, '', `#${a.dataset.showCourse}`);
        document.getElementById('courses')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      });
    });
    addEventListener('hashchange', fromHash);
    fromHash();
  }

  // The photographs drift on their own; the button stops and restarts both rows.
  const marquees = document.querySelector<HTMLElement>('[data-marquees]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  if (marquees && toggle) {
    toggle.addEventListener('click', () => {
      const paused = marquees.classList.toggle('is-paused');
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Play the photographs' : 'Pause the photographs';
    });
  }
</script>

<style>
  /* ---------- prices: both currencies without script, the visitor's one with it ---------- */
  :global(html.js[data-currency='ngn']) .trainings [data-cur='usd'],
  :global(html.js[data-currency='usd']) .trainings [data-cur='ngn'],
  :global(html.js[data-currency]) .trainings .price__or { display: none; }
  .price { white-space: nowrap; }

  /* ---------- head ---------- */
  .page-head { padding-block: clamp(3rem, 7vh, 5rem) clamp(3rem, 6vw, 5rem); align-items: end; row-gap: clamp(2.5rem, 5vw, 4rem); }
  .page-head__title { grid-column: 1 / span 6; }
  .page-head__side { grid-column: 7 / -1; display: grid; gap: 1.25rem; }
