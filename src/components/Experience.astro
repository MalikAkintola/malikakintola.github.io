---
// Experience. The rail holds the heading and the way to the full résumé; across the right, two-ended
// rows that open to show what was done in each role. The current role carries the red mark.
import type { CollectionEntry } from 'astro:content';
import { span } from '../lib/dates';

interface Props { roles: CollectionEntry<'experience'>[] }
const { roles } = Astro.props;
const endKey = (e: string) => (e === 'present' ? '9999-99' : e);
const newest = (a: CollectionEntry<'experience'>, b: CollectionEntry<'experience'>) =>
  endKey(b.data.end).localeCompare(endKey(a.data.end)) || b.data.start.localeCompare(a.data.start);
const groups = [
  { label: 'Work', items: roles.filter((r) => r.data.kind === 'work').sort(newest) },
  { label: 'Teaching and volunteering', items: roles.filter((r) => r.data.kind === 'volunteer').sort(newest) },
];
---
<section id="experience" class="band" aria-labelledby="experience-title">
  <div class="grid">
    <div class="rail">
      <div class="rail__inner">
        <h2 id="experience-title" class="head" data-reveal>Experience</h2>
        <p data-reveal style="--i: 1">Payments data at Remita, consulting for a microfinance bank, and more than 600 people taught. Open any role for the detail.</p>
        <p data-reveal style="--i: 2"><a class="link" href="/resume/">Read the full résumé</a> or <a class="link" href="/resume.pdf">download it as a PDF</a>.</p>
      </div>
    </div>

    <div class="content">
      {groups.map((g) => (
        <div class="experience__group">
          <h3 class="experience__word muted" data-reveal>{g.label}</h3>
          {g.items.map((r, i) => (
            <details class="row" data-reveal style={`--i: ${i}`}>
              <summary class="row__line">
                <span class:list={['row__dot', r.data.end === 'present' && 'is-now']} aria-hidden="true"></span>
                <span class="row__role">{r.data.role}</span>
                <span class="row__org">{r.data.org}</span>
                <span class="row__when small muted nums">{span(r.data.start, r.data.end)}</span>
              </summary>
              <ul class="row__points">
                {r.data.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience__group + .experience__group { margin-top: 3rem; }
  .experience__word { font-size: var(--step-body); font-weight: 400; letter-spacing: 0; margin-bottom: 0.5rem; }
  .row__line {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1.1fr) minmax(0, 1.4fr) auto;
    column-gap: 1rem;
    align-items: baseline;
    min-height: 3rem;
    padding: 0.625rem 0.75rem;
    margin-inline: -0.75rem;
    list-style: none;
    cursor: pointer;
    transition: background-color var(--t-hover) ease;
  }
  .row__line::-webkit-details-marker { display: none; }
  .row__line:hover, .row[open] .row__line { background: var(--surface); }
  .row__dot { width: 0.625rem; height: 0.625rem; border-radius: 50%; background: var(--surface-2); transform: translateY(-0.05em); }
  .row__dot.is-now { background: var(--accent); }
  .row__role { font-weight: 600; }
  .row__org { color: var(--ink); }
  .row__when { white-space: nowrap; text-align: right; }
  .row__points { display: grid; gap: 0.5rem; margin: 0.75rem 0 1.25rem calc(2rem); padding-left: 1rem; max-width: 70ch; }
  .row[open] .row__points { animation: row-open var(--t-ui) var(--ease-out); }
  @keyframes row-open { from { opacity: 0; transform: translateY(-4px); } }
  @media (max-width: 48em) {
    .row__line { grid-template-columns: 1rem 1fr; row-gap: 0.125rem; }
    .row__org, .row__when { grid-column: 2; text-align: left; }
    .row__points { margin-left: 0; }
  }
</style>
