---
// Footer: "A single quiet line". What this is, a few links centred, the year.
import { getEntry } from 'astro:content';
interface Props { credit?: string }
const { credit } = Astro.props;
const me = (await getEntry('profile', 'me'))!.data;
const year = new Date().getFullYear();
---
<footer class="footer small band--ink">
  <p class="muted">{me.name}, {me.role.toLowerCase()}</p>
  <nav class="footer__links" aria-label="Footer">
    <a class="link" href="/projects/">Projects</a>
    <a class="link" href="/blog/">Blog</a>
    <a class="link" href="/#experience">Experience</a>
    <a class="link" href="/resume/">Résumé</a>
    <a class="link" href={me.linkedin} rel="noopener" target="_blank">LinkedIn</a>
    <a class="link" href={me.github} rel="noopener" target="_blank">GitHub</a>
  </nav>
  <p class="footer__year muted nums">© {year}</p>
  {credit && <p class="footer__credit muted">{credit}</p>}
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 1.5rem;
    margin-top: 0;
    padding: 4rem var(--margin) 1.875rem;
  }
  .footer__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .footer__year { text-align: right; }
  .footer__credit { grid-column: 1 / -1; font-size: 0.8125rem; max-width: none; }
  @media (max-width: 48em) {
    .footer { grid-template-columns: 1fr; gap: 0.5rem; padding-top: 3rem; padding-bottom: 1.5rem; }
    .footer__year { text-align: left; }
  }
</style>
