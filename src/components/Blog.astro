---
// Blog on the home page: three highlighted articles, and the way to all of them.
import type { CollectionEntry } from 'astro:content';
import ArticleRow from './ArticleRow.astro';

interface Props {
  articles: CollectionEntry<'writing'>[];
  projects: CollectionEntry<'projects'>[];
  total: number;
}
const { articles, projects, total } = Astro.props;
---
<section id="blog" class="band" aria-labelledby="blog-title">
  <div class="grid">
    <div class="rail">
      <div class="rail__inner">
        <h2 id="blog-title" class="head" data-reveal>Blog</h2>
        <p data-reveal style="--i: 1">How I work through analysis problems in Power BI and DAX, written so you can try them yourself.</p>
        <p data-reveal style="--i: 2"><a class="button button--ink" href="/blog/">See all {total} articles</a></p>
      </div>
    </div>
    <div class="content blog__list">
      {articles.map((article, i) => <ArticleRow article={article} projects={projects} index={i} />)}
    </div>
  </div>
</section>

<style>
  .blog__list { display: grid; gap: clamp(2.5rem, 4vw, 3.5rem); }
</style>
